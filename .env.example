# Modèle des variables d'environnement du frontend.
# Copier en .env et remplir. Le .env réel n'est jamais commité.

# --- Supabase (auth admin + paiements / avis / visas / messages de contact) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- API FastAPI (inscriptions -> Google Drive + notification agence) ---
# En local : http://localhost:8000
# En production : l'URL publique de l'API déployée (Railway), à définir aussi
# dans les variables d'environnement du projet Vercel.
VITE_API_URL=http://localhost:8000
