# Copier ce fichier en .env et remplir avec vos vraies valeurs.
# Ne JAMAIS committer le .env réel (déjà couvert par .gitignore).

# --- Google Drive / Sheets (OAuth compte Gmail réel, PAS un compte de service) ---
# Obtenus une seule fois via : python scripts/get_refresh_token.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
REGISTRATIONS_INDEX_SHEET_ID=
REGISTRATIONS_INDEX_SHEET_TAB=Inscriptions

# --- Email admin (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@saalimvoyages.com
ADMIN_NOTIFICATION_EMAIL=saalimvoyages@gmail.com

# --- Compte admin (un seul, gere par l'API) ---
# Generer ADMIN_PASSWORD_HASH et JWT_SECRET avec : python scripts/hash_password.py
ADMIN_EMAIL=saalimvoyages@gmail.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# --- CORS ---
FRONTEND_ORIGIN=https://votre-domaine-vercel.app

ENVIRONMENT=development
